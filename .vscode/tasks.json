{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "g++: Debug bauen",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile", "-ExecutionPolicy", "Bypass",
          "-File", "${workspaceFolder}/.vscode/build.ps1",
          "${config:boostRoot}"
        ]
      },
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/.vscode/build.sh",
          ""
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/.vscode/build.sh",
          "${config:boostRootMac}"
        ]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
