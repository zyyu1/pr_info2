{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "g++: Debug",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "g++: Debug bauen",
      "program": "${workspaceFolder}/build/Debug/outDebug",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "windows": {
        "program": "${workspaceFolder}/build/Debug/outDebug.exe",
        //"externalConsole": true,
        "externalConsole": false,
        "MIMode": "gdb",
        "miDebuggerPath": "gdb"
      },
      "linux": {
        "MIMode": "gdb",
        "miDebuggerPath": "gdb"
      },
      "osx": {
        "MIMode": "lldb"
      }
    }
  ]
}
